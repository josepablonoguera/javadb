<?xml version="1.0" encoding="UTF-8"?>
<project name="JavaMySQLMVC" default="run" basedir=".">
    <description>Proyecto base Java + Ant + MVC + DAO + JDBC (MySQL).</description>

    <property name="src.dir" value="src"/>
    <property name="resources.dir" value="resources"/>
    <property name="build.dir" value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="jar.dir" value="${build.dir}/jar"/>
    <property name="jar.name" value="javadb-base.jar"/>
    <property name="main.class" value="main.Main"/>

    <path id="project.classpath">
        <fileset dir="lib" includes="**/*.jar"/>
    </path>

    <target name="clean" description="Limpia artefactos de compilación">
        <delete dir="${build.dir}"/>
    </target>

    <target name="compile" description="Compila clases Java">
        <mkdir dir="${classes.dir}"/>
        <javac srcdir="${src.dir}" destdir="${classes.dir}" includeantruntime="false" encoding="UTF-8">
            <classpath refid="project.classpath"/>
        </javac>
        <copy todir="${classes.dir}">
            <fileset dir="${resources.dir}" excludes="**/*.java"/>
        </copy>
    </target>

    <target name="jar" depends="compile" description="Genera JAR ejecutable">
        <mkdir dir="${jar.dir}"/>
        <jar destfile="${jar.dir}/${jar.name}" basedir="${classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
                <attribute name="Class-Path" value="lib/mysql-connector-j.jar"/>
            </manifest>
        </jar>
    </target>

    <target name="run" depends="jar" description="Ejecuta aplicación">
        <java jar="${jar.dir}/${jar.name}" fork="true">
            <classpath refid="project.classpath"/>
        </java>
    </target>
</project>
